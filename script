// Executa após o carregamento completo do DOM
document.addEventListener("DOMContentLoaded", () => {
    initAccordions();
    initThemeAndFont();
    initVoiceSynthesis();
    initForms();
});

/* ==========================================================================
   1. ACCORDIONS (Seções Expansíveis)
   ========================================================================== */
function initAccordions() {
    const triggers = document.querySelectorAll(".accordion-trigger");
    
    triggers.forEach(trigger => {
        trigger.addEventListener("click", () => {
            const isExpanded = trigger.getAttribute("aria-expanded") === "true";
            const panelId = trigger.getAttribute("aria-controls");
            const panel = document.getElementById(panelId);
            const icon = trigger.querySelector(".accordion-icon");
            
            // Alterna estado do botão
            trigger.setAttribute("aria-expanded", !isExpanded);
            
            // Alterna visibilidade do painel
            if (isExpanded) {
                panel.setAttribute("hidden", "");
                icon.textContent = "+";
            } else {
                panel.removeAttribute("hidden");
                icon.textContent = "−";
            }
        });
    });
}

/* ==========================================================================
   2. ACESSIBILIDADE: TAMANHO DE FONTE E TEMA CLARO/ESCURO
   ========================================================================== */
function initThemeAndFont() {
    let currentFontSize = 100; // Porcentagem
    const body = document.body;
    
    const btnIncrease = document.getElementById("btn-increase-font");
    const btnDecrease = document.getElementById("btn-decrease-font");
    const btnToggleTheme = document.getElementById("btn-toggle-theme");
    
    btnIncrease.addEventListener("click", () => {
        if (currentFontSize < 140) {
            currentFontSize += 10;
            body.style.fontSize = `${currentFontSize}%`;
        }
    });
    
    btnDecrease.addEventListener("click", () => {
        if (currentFontSize > 80) {
            currentFontSize -= 10;
            body.style.fontSize = `${currentFontSize}%`;
        }
    });
    
    btnToggleTheme.addEventListener("click", () => {
        const currentTheme = body.getAttribute("data-theme");
        if (currentTheme === "dark") {
            body.removeAttribute("data-theme");
        } else {
            body.setAttribute("data-theme", "dark");
        }
    });
}

/* ==========================================================================
   3. ACESSIBILIDADE: LEITURA POR VOZ (SpeechSynthesis API)
   ========================================================================== */
function initVoiceSynthesis() {
    const btnStart = document.getElementById("btn-start-voice");
    const btnStop = document.getElementById("btn-stop-voice");
    
    let utterance = null;
    
    btnStart.addEventListener("click", () => {
        // Para qualquer leitura ativa anterior
        window.speechSynthesis.cancel();
        
        // Obtém apenas o conteúdo textual da área principal
        const mainTextElement = document.getElementById("main-text-content");
        if (!mainTextElement) return;
        
        // Limpeza básica para melhor fluidez da leitura por voz
        const textToRead = mainTextElement.innerText;
        
        utterance = new SpeechSynthesisUtterance(textToRead);
        utterance.lang = "pt-BR";
        utterance.rate = 1.0;
        
        window.speechSynthesis.speak(utterance);
        
        btnStart.style.backgroundColor = "var(--color-orange-accent)";
        btnStart.style.color = "white";
    });
    
    btnStop.addEventListener("click", () => {
        window.speechSynthesis.cancel();
        btnStart.style.backgroundColor = "var(--color-green-light)";
        btnStart.style.color = "var(--color-green-dark)";
    });
}

/* ==========================================================================
   4. INTERAÇÃO E VALIDAÇÃO DE FORMULÁRIOS
   ========================================================================== */
function initForms() {
    // Formulário de Inscrição
    const registerForm = document.getElementById("register-form");
    const formFeedback = document.getElementById("form-feedback");
    
    registerForm.addEventListener("submit", (e) => {
        e.preventDefault();
        
        const name = document.getElementById("inp-name").value.trim();
        const email = document.getElementById("inp-email").value.trim();
        const city = document.getElementById("inp-city").value.trim();
        const state = document.getElementById("inp-state").value.trim();
        
        if (!name || !email || !city || !state) {
            alert("Por favor, preencha todos os campos obrigatórios.");
            return;
        }
        
        formFeedback.removeAttribute("hidden");
        formFeedback.className = "feedback-message success";
        formFeedback.textContent = `Sucesso! Inscrição confirmada para o Seminário, ${name}.`;
        
        registerForm.reset();
    });
    
    // Formulário de Comentários
    const commentForm = document.getElementById("comment-form");
    const commentsList = document.getElementById("comments-list");
    
    commentForm.addEventListener("submit", (e) => {
        e.preventDefault();
        
        const commentText = document.getElementById("txt-comment").value.trim();
        if (!commentText) return;
        
        // Criar elemento de comentário visualmente estruturado e limpo
        const commentItem = document.createElement("div");
        commentItem.className = "comment-item";
        
        // Define data/hora da postagem de forma amigável
        const now = new Date();
        const timeString = now.toLocaleTimeString("pt-BR", { hour: '2-digit', minute: '2-digit' });
        
        commentItem.innerHTML = `<strong>Leitor Anônimo (${timeString}):</strong> <p>${commentText}</p>`;
        
        // Insere no topo da lista
        commentsList.insertBefore(commentItem, commentsList.firstChild);
        
        commentForm.reset();
    });
}